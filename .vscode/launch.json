{
  "version": "0.2.0",
  "configurations": [
{
  "name": "Attach to Integrated Browser",
  "request": "attach",
  "type": "editor-browser",
  "url": "http://localhost:8000/ui.html",
      "webRoot": "${workspaceFolder}"
},    
    
{
      "name": "Launch Firefox against localhost",
      "type": "firefox",
      "request": "launch",
      "reAttach": true,
      "url": "http://localhost:8000/ui.html",
      "webRoot": "${workspaceFolder}",

        
       "reloadOnChange": {
      "watch": [ "${workspaceFolder}/**/*.js" ],
  },
  
          "log": {
        "consoleLevel": {
          "default": "Error" // Forces all Firefox console errors into VS Code
        }
      }
    }
  ]
}
